{
  "name": "qbit-toolbox",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@puppeteer/browsers": "3.2.6",
    "serialize-javascript": "7.1.4"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "features/*/ui"
  ],
  "scripts": {
    "e2e:build": "bun run --filter @qbit/desktop tauri build --no-bundle --features desktop-e2e --config src-tauri/tauri.e2e.conf.json -- --target-dir ../../../target/e2e",
    "e2e:desktop": "node tools/run-desktop-e2e.mjs",
    "dev": "bun run --filter @qbit/desktop dev",
    "build": "bun run --filter @qbit/desktop build",
    "lint": "bun run --filter @qbit/desktop lint && bun run --filter @qbit/hotkeys-ui lint",
    "typecheck": "bunx tsc --project tsconfig.tools.json && bun run --filter @qbit/desktop typecheck",
    "test": "bun run --filter @qbit/desktop test && node --test tests/e2e/isolation.test.mjs",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "ipc:generate": "cargo +1.97.1 run -p ipc-contracts --bin generate-ipc -- packages/ipc/generated/index.ts",
    "ipc:check": "bun tools/check-ipc-generated.ts",
    "version:check": "bun tools/check-version-consistency.ts",
    "architecture:check": "bun tools/check-architecture-boundaries.ts",
    "ui:style-placement:check": "bun tools/check-ui-style-placement.ts",
    "rust:fmt": "cargo +1.97.1 fmt --all -- --check",
    "rust:clippy": "cargo +1.97.1 clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo +1.97.1 test --workspace",
    "check": "bun run version:check && bun run architecture:check && bun run ipc:check && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run ui:style-placement:check && bun run rust:fmt && bun run rust:clippy && bun run rust:test",
    "tauri": "bun run --filter @qbit/desktop tauri",
    "tauri:dev": "bun run --filter @qbit/desktop tauri dev",
    "tauri:build": "bun run --filter @qbit/desktop tauri build"
  },
  "devDependencies": {
    "@types/node": "^22.19.10",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.5.1",
    "axe-core": "4.11.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.2",
    "webdriverio": "9.31.9"
  }
}
